# PulseChat Mobile Environment Configuration Template
# Copy this file to .env and set your computer's local Wi-Fi IP address:
#
# Examples:
# EXPO_PUBLIC_API_URL=http://192.168.1.35:5000
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000 (for Android Emulator)
#
EXPO_PUBLIC_API_URL=http://192.168.1.35:5000
