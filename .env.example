# ==============================================================================
# PulseChat — Production Environment Variables Template
# ==============================================================================
# Copy this file to .env before deploying to production:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file with real secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Security & JWT Settings
# ------------------------------------------------------------------------------
# A secure, random 256-bit (at least 32 characters) secret key for JWT token signing.
# Generate one using: openssl rand -base64 32
JWT_SECRET=YourSuperSecretKeyMustBeAtLeast32CharactersLong2026!#

# ------------------------------------------------------------------------------
# 2. Database Configuration (Dual-Provider: PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# For Production (Cloud: Neon, Supabase, Render, Railway, or Docker Compose):
# Standard PostgreSQL connection URL (format: postgres://user:password@host:port/dbname)
DATABASE_URL=postgres://pulsechat:pulsechat_secret_2026@postgres:5432/pulsechat_db

# Password used by the PostgreSQL container when running via Docker Compose
POSTGRES_PASSWORD=pulsechat_secret_2026

# Note: If DATABASE_URL is left empty or omitted, PulseChat automatically falls back
# to zero-config local SQLite storage (pulsechat.db).

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web frontend domains that can make API/SignalR requests.
# In production, replace with your live domain (e.g., https://pulsechat.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Optional for Vercel / Netlify)
# ------------------------------------------------------------------------------
# If frontend is hosted separately from the backend (e.g., Frontend on Vercel, Backend on Render),
# configure this environment variable in your Vercel project settings:
# VITE_API_URL=https://your-pulsechat-backend.onrender.com
